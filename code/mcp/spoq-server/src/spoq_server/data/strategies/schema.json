{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoqpaper.com/schemas/strategy-1.json",
  "title": "SPOQ declarative strategy definition, schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "phases",
    "edges",
    "entry",
    "max_transitions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "entry": {
      "$ref": "#/$defs/identifier"
    },
    "max_transitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "op"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "in",
            "truthy"
          ]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "in"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "skill",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "skill",
            "gate",
            "human",
            "design",
            "join"
          ]
        },
        "skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "config": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "skill",
                  "gate",
                  "design"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "skill": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "on": {
          "enum": [
            "pass",
            "fail",
            "always"
          ]
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/predicate"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
