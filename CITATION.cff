cff-version: 1.2.0
title: "SPOQ: Specialist Orchestrated Queuing for Multi-Agent Software Engineering"
message: "If you use SPOQ in your research, please cite it using this metadata."
type: software
license: MIT
repository-code: "https://github.com/Durban-Designer/spoq"
url: "https://spoqpaper.com"
authors:
